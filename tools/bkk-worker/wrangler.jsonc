{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmenetrend-bkk-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "*" },
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "61001", "simple": { "limit": 120, "period": 60 } },
    { "name": "PLAN_LIMITER", "namespace_id": "61002", "simple": { "limit": 12, "period": 60 } }
  ]
}
