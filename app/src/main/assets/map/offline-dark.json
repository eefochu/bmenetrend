{
  "version": 8,
  "name": "Hungary offline context dark",
  "glyphs": "asset://map/offline/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "offline-hungary": {
      "type": "vector",
      "url": "pmtiles://file://OFFLINE_BASEMAP",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a> · <a href=\"https://opendatacommons.org/licenses/odbl/1-0/\">ODbL 1.0</a> · Geofabrik · 2026-10-25"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#172126"
      }
    },
    {
      "id": "land-built",
      "type": "fill",
      "source": "offline-hungary",
      "source-layer": "land",
      "paint": {
        "fill-color": "#253036"
      },
      "filter": [
        "==",
        "kind",
        "built"
      ]
    },
    {
      "id": "land-green",
      "type": "fill",
      "source": "offline-hungary",
      "source-layer": "land",
      "paint": {
        "fill-color": "#203b32"
      },
      "filter": [
        "==",
        "kind",
        "green"
      ]
    },
    {
      "id": "water",
      "type": "fill",
      "source": "offline-hungary",
      "source-layer": "water",
      "paint": {
        "fill-color": "#173f55"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "offline-hungary",
      "source-layer": "waterways",
      "paint": {
        "line-color": "#2e6178",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.7,
          15,
          3
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "offline-hungary",
      "source-layer": "roads",
      "paint": {
        "line-color": "#152025",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.3,
          13,
          3,
          16,
          8,
          19,
          14
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "offline-hungary",
      "source-layer": "roads",
      "paint": {
        "line-color": "#657178",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          13,
          2,
          16,
          6,
          19,
          12
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "offline-hungary",
      "source-layer": "roads",
      "paint": {
        "line-color": "#b6a580",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          13,
          2,
          16,
          6,
          19,
          12
        ]
      },
      "filter": [
        "in",
        "kind",
        "motorway",
        "motorway_link",
        "trunk",
        "trunk_link",
        "primary",
        "primary_link",
        "secondary",
        "secondary_link",
        "tertiary",
        "tertiary_link"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "offline-hungary",
      "source-layer": "railways",
      "paint": {
        "line-color": "#a69ba8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.6,
          16,
          2
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "offline-hungary",
      "source-layer": "roads",
      "paint": {
        "text-color": "#f0f2ed",
        "text-halo-color": "#172126",
        "text-halo-width": 1.5
      },
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-max-angle": 35,
        "text-padding": 4
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "offline-hungary",
      "source-layer": "places",
      "paint": {
        "text-color": "#f0f2ed",
        "text-halo-color": "#172126",
        "text-halo-width": 1.5
      },
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind"
          ],
          "city",
          18,
          "town",
          16,
          "village",
          14,
          12
        ],
        "text-padding": 8,
        "text-max-width": 9
      }
    }
  ]
}
